{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v1/stage2a-signed-execution-completion.schema.json",
  "title": "Stage 2a Machine Ed25519 JCS execution_completion envelope (draft)",
  "type": "object",
  "required": [
    "schema_version",
    "purpose",
    "issuer_public_key_base64url",
    "payload_sha256",
    "payload_base64url",
    "signature_base64url"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "purpose": {
      "const": "agent-bot/stage2a-execution-completion/v1"
    },
    "issuer_public_key_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signature_base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v1/launch-input-records.schema.json",
  "title": "Stage 2a exact launch-input closure object",
  "description": "Exact object hashed with the distinct stage2a launch-inputs domain. It binds sorted external file records, parsed host projection values, selected command/full argv, static nonsecret environment, effective config, system-image constraints, sandbox policy and named component digests. Physical custody and execution still require independent Machine observation.",
  "type": "object",
  "required": ["files", "host_projection", "selected_command", "argv", "environment", "effective_config", "system_images", "sandbox_policy_digest", "component_digests"],
  "properties": {
    "files": {
      "description": "Sorted regular-file records whose paths are relative to the distinct root-owned launch projection, never the Soul installation root.",
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "https://true-line.ai/soul-contracts/machine/v1/definition-records.schema.json#/$defs/file" }
    },
    "host_projection": {
      "type": "object", "required": ["adapters", "installation"],
      "properties": {
        "adapters": { "type": "object", "maxProperties": 256 },
        "installation": { "type": "object", "maxProperties": 256 }
      },
      "additionalProperties": false
    },
    "selected_command": { "$ref": "https://true-line.ai/soul-contracts/machine/v1/snapshot-identity.schema.json#/properties/root_path" },
    "argv": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "environment": {
      "description": "Exact static nonsecret environment values; dynamic credentials and B-only proof remain outside this object and outside R's environment.",
      "type": "object", "maxProperties": 256,
      "patternProperties": { "^[A-Za-z_][A-Za-z0-9_]*$": { "type": "string", "maxLength": 8192 } },
      "additionalProperties": false
    },
    "effective_config": {
      "type": "object", "maxProperties": 256, "required": ["profile"],
      "properties": { "profile": { "enum": ["managed-protected", "managed-cooperative"] } }
    },
    "system_images": {
      "type": "object", "required": ["product_version", "build_version", "darwin_kernel", "selected"],
      "properties": {
        "product_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "build_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "darwin_kernel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "selected": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object", "required": ["path", "signing_requirement", "cdhash"],
            "properties": {
              "path": { "$ref": "https://true-line.ai/soul-contracts/machine/v1/snapshot-identity.schema.json#/properties/root_path" },
              "signing_requirement": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "cdhash": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sandbox_policy_digest": { "$ref": "#/$defs/digest" },
    "component_digests": {
      "description": "The bridge field names the per-installation B executable; each digest is independently compared with the matching projected file and observed process.",
      "type": "object",
      "required": ["machine", "hq", "souls", "bridge", "comms_broker", "adapter", "harness", "test_provider"],
      "properties": {
        "machine": { "$ref": "#/$defs/digest" },
        "hq": { "$ref": "#/$defs/digest" },
        "souls": { "$ref": "#/$defs/digest" },
        "bridge": { "$ref": "#/$defs/digest" },
        "comms_broker": { "$ref": "#/$defs/digest" },
        "adapter": { "$ref": "#/$defs/digest" },
        "harness": { "$ref": "#/$defs/digest" },
        "test_provider": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

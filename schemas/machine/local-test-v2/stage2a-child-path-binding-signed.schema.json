{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/local-test-v2/stage2a-child-path-binding-signed.schema.json",
  "title": "Synthetic Stage 2a c5 signed child path and ancillary order envelope",
  "description": "Purpose-separated A-signed source fixture. Verify canonical payload bytes, digest, fixed issuer pin, signature, per-start slot, path derivation and ancillary ordering independently. This draft is not an installed client authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["purpose", "schema_version", "issuer_public_key_base64url", "payload_base64url", "payload_sha256", "signature_base64url"],
  "properties": {
    "purpose": { "const": "agent-bot/stage2a-child-path-binding-local-test/v1" },
    "schema_version": { "const": 1 },
    "issuer_public_key_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "payload_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "payload_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
  }
}

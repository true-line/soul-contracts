{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json",
  "title": "Stage 2a admin-owned frozen snapshot identity",
  "description": "Machine secure-admin-owned, runner-group-readable frozen snapshot. The identity is bound in the signed per-start reservation; shape does not prove no-follow descriptor custody, immutable publication, or pre-exec observation.",
  "type": "object",
  "required": [
    "root_path",
    "device",
    "inode",
    "generation",
    "birthtime_ns",
    "owner_uid",
    "owner_gid",
    "mode"
  ],
  "properties": {
    "root_path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.\\.?(/|$))[\\x20-\\x7e]+$",
      "not": {
        "pattern": "\\\\"
      }
    },
    "device": {
      "$ref": "#/$defs/decimal"
    },
    "inode": {
      "$ref": "#/$defs/decimal"
    },
    "generation": {
      "$ref": "#/$defs/decimal"
    },
    "birthtime_ns": {
      "$ref": "#/$defs/decimal"
    },
    "owner_uid": {
      "type": "integer",
      "minimum": 400,
      "maximum": 4294967295
    },
    "owner_gid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "mode": {
      "const": "0555"
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v2/stage2a-report-commitment-payload.schema.json",
  "title": "Stage 2a post-sign exact host report commitment successor (draft)",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "profile_in_force",
    "host_id",
    "signer_id",
    "installation_id",
    "soul_id",
    "start_id",
    "launch_id",
    "cohort_id",
    "execution_completion_sha256",
    "report_payload_sha256",
    "report_envelope_sha256",
    "committed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "stage2a-report-commitment"
    },
    "execution_completion_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "report_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "report_envelope_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_in_force": {
      "enum": [
        "managed-protected",
        "managed-cooperative"
      ]
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "signer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "soul_id": {
      "type": "string",
      "pattern": "^agent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "start_id": {
      "type": "string",
      "pattern": "^st_[0-9a-f]{24}$"
    },
    "launch_id": {
      "type": "string",
      "pattern": "^ln_[0-9a-f]{24}$"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false
}

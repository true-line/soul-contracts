{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v2/stage2a-execution-completion-payload.schema.json",
  "title": "Stage 2a pre-sign completed-execution successor with exact Q joins (draft)",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "profile_in_force",
    "host_id",
    "installation_id",
    "soul_id",
    "start_id",
    "launch_id",
    "cohort_id",
    "report_candidate_sha256",
    "reservation_sha256",
    "challenge_sha256",
    "measurement_binding_sha256",
    "q_framed_wire_sha256",
    "q_frame_index_envelope_sha256",
    "q_clean_eof_envelope_sha256",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "stage2a-execution-completion"
    },
    "profile_in_force": {
      "enum": [
        "managed-protected",
        "managed-cooperative"
      ]
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "soul_id": {
      "type": "string",
      "pattern": "^agent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "start_id": {
      "type": "string",
      "pattern": "^st_[0-9a-f]{24}$"
    },
    "launch_id": {
      "type": "string",
      "pattern": "^ln_[0-9a-f]{24}$"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "report_candidate_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reservation_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "finalization_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bridge_assignment_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cooperative_order_receipt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "challenge_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "measurement_binding_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "q_framed_wire_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "q_frame_index_envelope_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "q_clean_eof_envelope_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "profile_in_force": {
            "const": "managed-protected"
          }
        },
        "required": [
          "profile_in_force"
        ]
      },
      "then": {
        "required": [
          "finalization_sha256"
        ],
        "properties": {
          "bridge_assignment_sha256": false,
          "cooperative_order_receipt_sha256": false
        }
      },
      "else": {
        "required": [
          "bridge_assignment_sha256",
          "cooperative_order_receipt_sha256"
        ],
        "properties": {
          "finalization_sha256": false
        }
      }
    }
  ]
}

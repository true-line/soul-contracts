{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-signed-ready.schema.json",
  "title": "Purpose-separated A-signed exact two-member readiness (draft)",
  "description": "Ed25519 signs the ASCII purpose, one NUL byte and the exact RFC 8785 JCS UTF-8 payload bytes. Independently pin the paired secure-admin Machine issuer, the signed assignment and the paired HQ mapping before consuming this record.",
  "type": "object",
  "required": ["schema_version", "purpose", "issuer_public_key_base64url", "payload_sha256", "payload_base64url", "signature_base64url"],
  "properties": {
    "schema_version": { "const": 1 },
    "purpose": { "const": "agent-bot/stage2a-member-set-ready/v1" },
    "issuer_public_key_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "payload_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "signature_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "additionalProperties": false
}

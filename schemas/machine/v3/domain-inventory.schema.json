{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v3/domain-inventory.schema.json",
  "title": "Stage 2a A-sealed H or R domain inventory (draft)",
  "type": "object",
  "required": [
    "contract",
    "kind",
    "schema_version",
    "domain",
    "installation_id",
    "limits",
    "directories",
    "files",
    "total_bytes"
  ],
  "properties": {
    "contract": {
      "const": "machine/v3"
    },
    "kind": {
      "const": "stage2a-domain-inventory"
    },
    "schema_version": {
      "const": 3
    },
    "domain": {
      "enum": [
        "H-code",
        "R-runtime"
      ]
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "limits": {
      "type": "object",
      "required": [
        "max_files",
        "max_file_bytes",
        "max_total_bytes"
      ],
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 402653184
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      },
      "additionalProperties": false
    },
    "directories": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[A-Za-z0-9._+@/-]+$"
          },
          "kind": {
            "const": "directory"
          },
          "mode": {
            "enum": [
              "0550",
              "0555"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "mode",
          "size_bytes",
          "sha256",
          "component_id",
          "release_path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[A-Za-z0-9._+@/-]+$"
          },
          "kind": {
            "const": "regular"
          },
          "mode": {
            "enum": [
              "0440",
              "0550"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 402653184
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "component_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "release_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)[A-Za-z0-9._+@/-]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    }
  },
  "additionalProperties": false
}

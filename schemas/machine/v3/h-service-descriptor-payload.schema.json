{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v3/h-service-descriptor-payload.schema.json",
  "title": "Static A-signed HQ service installed descriptor (draft)",
  "type": "object",
  "required": [
    "contract",
    "kind",
    "schema_version",
    "host_id",
    "hq_installation_id",
    "owner_plan_digest",
    "h_inventory",
    "components",
    "outer_launch",
    "runtime"
  ],
  "properties": {
    "contract": {
      "const": "machine/v3"
    },
    "kind": {
      "const": "stage2a-h-service-descriptor"
    },
    "schema_version": {
      "const": 3
    },
    "host_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hq_installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "owner_plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "h_inventory": {
      "$ref": "https://true-line.ai/soul-contracts/machine/v3/inventory-ref.schema.json"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "source_repository",
          "source_commit",
          "release_artifact_sha256",
          "release_manifest_sha256"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "source_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_tag": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]{0,127}$"
          },
          "release_artifact_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "release_manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "outer_launch": {
      "type": "object",
      "required": [
        "ruby_path",
        "ruby_sha256",
        "helper_path",
        "helper_sha256",
        "argv"
      ],
      "properties": {
        "ruby_path": {
          "const": "/usr/bin/ruby"
        },
        "ruby_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "helper_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "helper_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "argv": {
          "type": "array",
          "minItems": 11,
          "maxItems": 36,
          "prefixItems": [
            {
              "const": "/usr/bin/ruby"
            },
            {
              "const": "--disable-gems"
            },
            {
              "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
            },
            {
              "const": "launch"
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "node_path",
        "node_sha256",
        "preloader_path",
        "preloader_sha256",
        "entry_path",
        "entry_sha256",
        "guard_module_path",
        "guard_module_sha256",
        "argv"
      ],
      "properties": {
        "node_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "node_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "preloader_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "preloader_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entry_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "entry_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "guard_module_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "guard_module_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "argv": {
          "type": "array",
          "minItems": 7,
          "maxItems": 32,
          "prefixItems": [
            {
              "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
            },
            {
              "const": "--no-addons"
            },
            {
              "const": "--disallow-code-generation-from-strings"
            },
            {
              "const": "--import"
            },
            {
              "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
            },
            {
              "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
            },
            {
              "const": "run"
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

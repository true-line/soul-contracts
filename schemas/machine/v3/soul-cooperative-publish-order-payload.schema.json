{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://true-line.ai/soul-contracts/machine/v3/soul-cooperative-publish-order-payload.schema.json",
  "title": "Managed cooperative A-signed publish intent (draft)",
  "required": [
    "contract",
    "kind",
    "schema_version",
    "reservation_sha256",
    "bridge_assignment_sha256",
    "bridge_grant_sha256",
    "bind_receipt_sha256",
    "relay_status_sha256",
    "installation_id",
    "start_id",
    "launch_id",
    "authorized_at"
  ],
  "properties": {
    "contract": {
      "const": "machine/v3"
    },
    "kind": {
      "const": "soul-cooperative-publish-order"
    },
    "schema_version": {
      "const": 3
    },
    "reservation_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bridge_assignment_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bridge_grant_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bind_receipt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relay_status_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "start_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "launch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

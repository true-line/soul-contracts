{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-runtime-lease-payload.schema.json",
  "title": "A-signed post-Ready runtime lease for one two-member R wrapper (draft)",
  "description": "Purpose agent-bot/stage2a-member-runtime-lease/v1 is separate from the inert pre-finalization lease. The fixed R wrapper requests its own renewal over the authenticated H admission channel; H must relay kernel-observed peer UID/PID, and A independently reobserves that exact wrapper, its ACP child, the other child, R, B, Q and owner driver before signing. The Ready envelope anchors first issuance before Ready expiry; later renewals require the previous signed runtime lease, strictly increasing sequence, a new 32-byte challenge and issuance before the previous lease expires. Each lease lasts at most five seconds and cannot exceed approved_until from the exact reloaded A-owned installed authority, whose digest is signed here. The installed authority is checked against the owner-reviewed plan and independently reopened root applied receipt on each issuance. The short reservation, assignment and Ready expiry do not extend via this record. A stopped, changed, expired, missing or unverified role refuses. The payload grants only the specified member's runtime; it does not grant B ingress by itself or prove physical qualification.",
  "type": "object",
  "required": ["contract", "kind", "schema_version", "profile_in_force", "host_id", "installation_id", "soul_id", "start_id", "hq_epoch", "reservation_sha256", "assignment_envelope_sha256", "child_observation_envelope_sha256", "ready_envelope_sha256", "member_b_authority_envelope_sha256", "hq_finalization_sha256", "bind_receipt_sha256", "installed_authority_sha256", "member_id", "member_selector", "member_launch_id", "runtime_id", "grant_sha256", "bridge_arm_receipt_sha256", "runner_process", "bridge_process", "q_process", "owner_driver_process", "launcher_process", "child_process", "challenge_nonce_base64url", "sequence", "previous_lease_envelope_sha256", "approved_until", "issued_at", "expires_at"],
  "properties": {
    "contract": { "const": "machine/v3" },
    "kind": { "const": "stage2a-member-runtime-lease" },
    "schema_version": { "const": 1 },
    "profile_in_force": { "const": "managed-protected" },
    "host_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/host_id" },
    "installation_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/installation_id" },
    "soul_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/soul_id" },
    "start_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/start_id" },
    "hq_epoch": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/hq_epoch" },
    "reservation_sha256": { "$ref": "#/$defs/digest" },
    "assignment_envelope_sha256": { "$ref": "#/$defs/digest" },
    "child_observation_envelope_sha256": { "$ref": "#/$defs/digest" },
    "ready_envelope_sha256": { "$ref": "#/$defs/digest" },
    "member_b_authority_envelope_sha256": { "$ref": "#/$defs/digest" },
    "hq_finalization_sha256": { "$ref": "#/$defs/digest", "description": "SHA-256 of the exact durably committed, authenticated paired H two-member finalization/mapping record; A checks that record against Ready and both child observations before signing any runtime lease." },
    "bind_receipt_sha256": { "$ref": "#/$defs/digest" },
    "installed_authority_sha256": { "$ref": "#/$defs/digest", "description": "SHA-256 of the exact A-owned installed policy bytes reloaded and checked against the current owner-approved plan and root applied receipt on this issuance." },
    "member_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_id" },
    "member_selector": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_selector" },
    "member_launch_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/launch_id" },
    "runtime_id": { "$ref": "https://true-line.ai/soul-contracts/hq/v1/admission-result.schema.json#/properties/admitted_runtimes/items/properties/runtime_id" },
    "grant_sha256": { "$ref": "#/$defs/digest" },
    "bridge_arm_receipt_sha256": { "$ref": "#/$defs/digest" },
    "runner_process": { "$ref": "#/$defs/roleProcess", "description": "A-reobserved R process, not the H daemon process or a caller assertion." },
    "bridge_process": { "$ref": "#/$defs/roleProcess" },
    "q_process": { "$ref": "#/$defs/roleProcess" },
    "owner_driver_process": { "$ref": "#/$defs/roleProcess" },
    "launcher_process": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-child-observation-payload.schema.json#/$defs/launcherProcess" },
    "child_process": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-child-observation-payload.schema.json#/$defs/childProcess" },
    "challenge_nonce_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "previous_lease_envelope_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "approved_until": { "type": "string", "format": "date-time" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [{ "if": { "properties": { "sequence": { "const": 1 } } }, "then": { "properties": { "previous_lease_envelope_sha256": { "type": "null" } } }, "else": { "properties": { "previous_lease_envelope_sha256": { "$ref": "#/$defs/digest" } } } }],
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "roleProcess": { "type": "object", "required": ["pid", "uid", "gid", "start_seconds", "start_micros"], "properties": { "pid": { "type": "integer", "minimum": 2 }, "uid": { "type": "integer", "minimum": 1 }, "gid": { "type": "integer", "minimum": 1 }, "start_seconds": { "type": "integer", "minimum": 1 }, "start_micros": { "type": "integer", "minimum": 0, "maximum": 999999 } }, "additionalProperties": false }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-live-lease-payload.schema.json",
  "title": "A-signed pre-finalization live lease for one inert ACP wrapper (draft)",
  "description": "Machine/keyd signs this purpose-separated lease for one prestarted two-member ACP wrapper only after rechecking both A-observed children and live H/R/B/Q custody. It binds the exact A-signed member-specific execution grant and two-child observation, own wrapper and child kernel identity, member selector and launch, fresh wrapper challenge and increasing per-member sequence. The signed validity is at most five seconds and cannot extend the reservation, assignment, grant, observation or owner attempt. The wrapper verifies its own signed grant, this lease, fixed installed A pin and live kernel tuples before retaining the inert child. This lease does not finalize Hello, authorize provider ingress, release ACP stdin or substitute for the later aggregate Ready. The singular finalized-Hello child lease remains unchanged.",
  "type": "object",
  "required": ["contract", "kind", "schema_version", "profile_in_force", "host_id", "installation_id", "soul_id", "start_id", "hq_epoch", "reservation_sha256", "assignment_envelope_sha256", "child_observation_envelope_sha256", "member_id", "member_selector", "member_launch_id", "grant_sha256", "launcher_process", "child_process", "challenge_nonce_base64url", "sequence", "issued_at", "expires_at"],
  "properties": {
    "contract": { "const": "machine/v3" },
    "kind": { "const": "stage2a-member-live-lease" },
    "schema_version": { "const": 1 },
    "profile_in_force": { "const": "managed-protected" },
    "host_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/host_id" },
    "installation_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/installation_id" },
    "soul_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/soul_id" },
    "start_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/start_id" },
    "hq_epoch": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/hq_epoch" },
    "reservation_sha256": { "$ref": "#/$defs/digest" },
    "assignment_envelope_sha256": { "$ref": "#/$defs/digest" },
    "child_observation_envelope_sha256": { "$ref": "#/$defs/digest" },
    "member_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_id" },
    "member_selector": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_selector" },
    "member_launch_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/launch_id" },
    "grant_sha256": { "$ref": "#/$defs/digest" },
    "launcher_process": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-child-observation-payload.schema.json#/$defs/launcherProcess" },
    "child_process": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-child-observation-payload.schema.json#/$defs/childProcess" },
    "challenge_nonce_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$", "description": "Canonical unpadded base64url of exactly 32 fresh wrapper challenge bytes, single-use per sequence." },
    "sequence": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v3/soul-cooperative-qualification-candidate-reservation-payload.schema.json",
  "title": "One-use uncertified cooperative qualification candidate reservation payload",
  "type": "object",
  "required": [
    "contract",
    "kind",
    "schema_version",
    "host_id",
    "issued_at",
    "expires_at",
    "installed_plan_receipt_sha256",
    "assignment",
    "adapter_transport",
    "endpoints",
    "measurement_binding",
    "admission_challenge_sha256",
    "qualification_only",
    "reviewed_start_id",
    "qualification_provider",
    "q_plan_id",
    "q_plan_digest",
    "test_plan_sha256",
    "provider_config_sha256"
  ],
  "properties": {
    "contract": {
      "const": "machine/v3"
    },
    "kind": {
      "const": "soul-cooperative-qualification-candidate-reservation"
    },
    "schema_version": {
      "const": 3
    },
    "host_id": {
      "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/$defs/id"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "installed_plan_receipt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "assignment": {
      "type": "object",
      "required": [
        "installation_id",
        "soul_id",
        "start_id",
        "launch_id",
        "plan_id",
        "plan_digest",
        "hq_epoch",
        "expires_at",
        "runner_account",
        "runner_uid",
        "runner_gid",
        "hq_uid",
        "machine_uid",
        "package_root",
        "launch_inputs_root",
        "runtime_root",
        "node_path",
        "entry_path",
        "state_root",
        "state_root_mode",
        "package_sha256",
        "soul_artifact_sha256"
      ],
      "properties": {
        "installation_id": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/$defs/id"
        },
        "soul_id": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/properties/soul_id"
        },
        "start_id": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/properties/start_id"
        },
        "launch_id": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/properties/launch_id"
        },
        "plan_id": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/$defs/id"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hq_epoch": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/properties/hq_epoch"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "runner_account": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,30}$"
        },
        "runner_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "runner_gid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "hq_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "machine_uid": {
          "type": "integer",
          "minimum": 400,
          "maximum": 4294967295
        },
        "package_root": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "launch_inputs_root": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "runtime_root": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "node_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "entry_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "state_root": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "state_root_mode": {
          "const": "0700"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "soul_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "adapter_transport": {
      "const": "direct-comms"
    },
    "bridge_launch_sha256": {
      "$ref": "#/$defs/bridgeLaunchDigest"
    },
    "endpoints": {
      "type": "object",
      "required": [
        "admission"
      ],
      "properties": {
        "admission": {
          "$ref": "#/$defs/endpoint",
          "properties": {
            "parent_device": false,
            "parent_inode": false,
            "parent_birthtime_ns": false
          }
        },
        "broker": {
          "$ref": "#/$defs/endpoint"
        },
        "member": {
          "$ref": "#/$defs/endpoint"
        },
        "relay": {
          "$ref": "#/$defs/endpoint"
        }
      },
      "additionalProperties": false
    },
    "measurement_binding": {
      "$ref": "#/$defs/cooperativeMeasurementBinding"
    },
    "admission_challenge_sha256": {
      "$ref": "#/$defs/digest"
    },
    "qualification_provider": {
      "$ref": "#/$defs/qualificationProvider"
    },
    "qualification_only": {
      "const": true
    },
    "reviewed_start_id": {
      "type": "string",
      "pattern": "^st_[0-9a-f]{24}$"
    },
    "q_plan_id": {
      "type": "string",
      "pattern": "^plan-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "q_plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "provider_config_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "if": {
    "properties": {
      "adapter_transport": {
        "const": "brokered-b"
      }
    }
  },
  "then": {
    "required": [
      "bridge_launch_sha256"
    ],
    "properties": {
      "endpoints": {
        "required": [
          "member",
          "relay"
        ],
        "properties": {
          "broker": false,
          "member": {
            "$ref": "#/$defs/parentIdentityRequired"
          },
          "relay": {
            "$ref": "#/$defs/parentIdentityRequired"
          }
        }
      }
    }
  },
  "else": {
    "properties": {
      "bridge_launch_sha256": false,
      "endpoints": {
        "required": [
          "broker"
        ],
        "properties": {
          "broker": {
            "properties": {
              "parent_device": false,
              "parent_inode": false,
              "parent_birthtime_ns": false
            }
          },
          "member": false,
          "relay": false
        }
      }
    }
  },
  "$defs": {
    "bridgeLaunchDigest": {
      "$ref": "#/$defs/digest",
      "description": "SHA-256 of the exact RFC 8785 JCS bytes of the private bridge assignment payload's bridge object. Compute before signing the primary reservation."
    },
    "adapterTransport": {
      "enum": [
        "direct-comms",
        "brokered-b"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cooperativeLaunchInputRecords": {
      "type": "object",
      "required": [
        "files",
        "host_projection",
        "selected_command",
        "argv",
        "environment",
        "effective_config",
        "system_images",
        "sandbox_policy_digest",
        "component_digests",
        "adapter_transport"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "https://true-line.ai/soul-contracts/machine/v1/definition-records.schema.json#/$defs/file"
          }
        },
        "host_projection": {
          "type": "object",
          "required": [
            "adapters",
            "installation"
          ],
          "properties": {
            "adapters": {
              "type": "object",
              "maxProperties": 256
            },
            "installation": {
              "type": "object",
              "maxProperties": 256
            }
          },
          "additionalProperties": false
        },
        "selected_command": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "environment": {
          "type": "object",
          "maxProperties": 256,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "additionalProperties": false
        },
        "effective_config": {
          "type": "object",
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "const": "managed-cooperative"
            },
            "qualification_provider_config_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "system_images": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v1/launch-input-records.schema.json#/properties/system_images"
        },
        "sandbox_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "adapter_transport": {
          "$ref": "#/$defs/adapterTransport"
        },
        "bridge_launch_sha256": {
          "$ref": "#/$defs/bridgeLaunchDigest"
        },
        "component_digests": {
          "type": "object",
          "required": [
            "machine",
            "hq",
            "souls",
            "comms_broker",
            "adapter"
          ],
          "properties": {
            "machine": {
              "$ref": "#/$defs/digest"
            },
            "hq": {
              "$ref": "#/$defs/digest"
            },
            "souls": {
              "$ref": "#/$defs/digest"
            },
            "comms_broker": {
              "$ref": "#/$defs/digest"
            },
            "adapter": {
              "$ref": "#/$defs/digest"
            },
            "harness": {
              "$ref": "#/$defs/digest"
            },
            "test_provider": {
              "$ref": "#/$defs/digest"
            }
          },
          "additionalProperties": false,
          "dependentRequired": {
            "harness": [
              "test_provider"
            ],
            "test_provider": [
              "harness"
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter_transport": {
                "const": "brokered-b"
              }
            }
          },
          "then": {
            "required": [
              "bridge_launch_sha256"
            ]
          },
          "else": {
            "properties": {
              "bridge_launch_sha256": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "component_digests": {
                "required": [
                  "test_provider"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "effective_config": {
                "required": [
                  "qualification_provider_config_sha256"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "effective_config": {
                "properties": {
                  "qualification_provider_config_sha256": false
                }
              }
            }
          }
        }
      ]
    },
    "cooperativeMeasurementBinding": {
      "type": "object",
      "required": [
        "contract",
        "kind",
        "schema_version",
        "installation_id",
        "soul_id",
        "start_id",
        "launch_id",
        "host_id",
        "hq_epoch",
        "plan_id",
        "installed_plan_digest",
        "package_sha256",
        "profile_in_force",
        "claimed_definition_digest",
        "definition_measurement",
        "launch_input_measurement",
        "snapshots",
        "soul_artifact_sha256",
        "h_service_descriptor_digest",
        "r_inventory",
        "r_components",
        "adapter_candidate",
        "hq_broker"
      ],
      "properties": {
        "contract": {
          "const": "machine/v3"
        },
        "kind": {
          "const": "stage2a-measurement-binding"
        },
        "schema_version": {
          "const": 3
        },
        "installation_id": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/$defs/id"
        },
        "soul_id": {
          "type": "string",
          "pattern": "^agent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "start_id": {
          "type": "string",
          "pattern": "^st_[0-9a-f]{24}$"
        },
        "launch_id": {
          "type": "string",
          "pattern": "^ln_[0-9a-f]{24}$"
        },
        "host_id": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/$defs/id"
        },
        "hq_epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_id": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/measurement-binding.schema.json#/$defs/id"
        },
        "installed_plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "soul_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Exact frozen installable .soul transport bytes. For the private Stage 2a pilot, the authenticated owner-approved exact installation-plan digest pins this artifact hash and Machine remeasures installed bytes. This field does not require or assert a separately signed .soul release receipt."
        },
        "profile_in_force": {
          "const": "managed-cooperative"
        },
        "claimed_definition_digest": {
          "$ref": "#/$defs/digest"
        },
        "definition_measurement": {
          "$ref": "#/$defs/digest"
        },
        "launch_input_measurement": {
          "$ref": "#/$defs/digest"
        },
        "snapshots": {
          "type": "object",
          "required": [
            "definition",
            "launch_inputs"
          ],
          "properties": {
            "definition": {
              "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json"
            },
            "launch_inputs": {
              "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json"
            }
          },
          "additionalProperties": false
        },
        "h_service_descriptor_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "r_inventory": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v3/inventory-ref.schema.json"
        },
        "r_components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "component_id",
              "source_repository",
              "source_commit",
              "release_artifact_sha256",
              "release_manifest_sha256"
            ],
            "properties": {
              "component_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "source_repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
              },
              "source_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "source_tag": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]{0,127}$"
              },
              "release_artifact_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "release_manifest_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "hq_broker": {
          "$ref": "#/$defs/hqBrokerBinding"
        },
        "adapter_candidate": {
          "type": "object",
          "required": [
            "component_id",
            "package_sha256",
            "release_manifest_sha256",
            "executable_path",
            "executable_sha256",
            "code_inputs_digest",
            "code_input_count",
            "status"
          ],
          "properties": {
            "component_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "package_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "release_manifest_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "executable_path": {
              "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
            },
            "executable_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "code_inputs_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "code_input_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "status": {
              "const": "uncertified-qualification-candidate"
            }
          },
          "additionalProperties": false,
          "description": "Exact reviewed adapter source bytes for a one-use qualification run; no adapter release attestation is claimed."
        }
      },
      "additionalProperties": false
    },
    "hqBrokerBinding": {
      "type": "object",
      "required": [
        "module_path",
        "module_sha256"
      ],
      "properties": {
        "module_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "module_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "qualificationProvider": {
      "type": "object",
      "required": [
        "config_base64url",
        "config_sha256"
      ],
      "properties": {
        "config_base64url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "config_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "parentIdentityRequired": {
      "required": [
        "parent_device",
        "parent_inode",
        "parent_birthtime_ns"
      ]
    },
    "endpoint": {
      "type": "object",
      "required": [
        "directory",
        "socket_path",
        "owner_uid",
        "group_gid",
        "dir_mode",
        "socket_mode",
        "expected_peer_uid"
      ],
      "properties": {
        "parent_device": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/device"
        },
        "parent_birthtime_ns": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/birthtime_ns",
          "not": {
            "const": "0"
          }
        },
        "parent_inode": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/inode",
          "not": {
            "const": "0"
          },
          "description": "Existing assigned parent directory inode. Live socket identities are observed after binding."
        },
        "directory": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "socket_path": {
          "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path"
        },
        "owner_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "group_gid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "dir_mode": {
          "const": 1512
        },
        "socket_mode": {
          "const": 432
        },
        "expected_peer_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

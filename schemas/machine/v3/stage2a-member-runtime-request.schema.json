{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-runtime-request.schema.json",
  "title": "Paired H-to-A protected post-Ready member runtime renewal request (draft)",
  "description": "H relays the fixed R wrapper's authenticated peer identity, current child and prior-lease chain together with the exact <=8192-byte reopened canonical H finalization record and SHA-256. A strictly decodes and byte-compares H bytes and digest to its accepted cached H finalization on every issuance, rechecks all signed and live joins, then may sign a separate <=5-second member runtime lease. R-to-H carries the finalization digest only; H-to-A carries bytes plus digest because A cannot read H's private store. The complete canonical request is at most 16384 bytes. This request does not grant B ingress, ACP permission or physical qualification.",
  "type": "object",
  "required": ["reservation_sha256", "installation_id", "start_id", "launch_id", "plan_id", "plan_digest", "hq_epoch", "member_id", "member_selector", "member_launch_id", "grant_sha256", "child_observation_envelope_sha256", "launcher_pid", "child_pid", "peer_uid", "peer_pid", "challenge_nonce_base64url", "after_sequence", "prior_expires_at", "ready_envelope_sha256", "hq_finalization_sha256", "hq_finalization_base64url", "previous_lease_envelope_sha256"],
  "properties": {
    "reservation_sha256": { "$ref": "#/$defs/digest" },
    "installation_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/installation_id" },
    "start_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/start_id" },
    "launch_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-reservation-payload.schema.json#/properties/assignment/properties/launch_id" },
    "plan_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/plan_id" },
    "plan_digest": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/plan_digest" },
    "hq_epoch": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/hq_epoch" },
    "member_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_id" },
    "member_selector": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_selector" },
    "member_launch_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/launch_id" },
    "grant_sha256": { "$ref": "#/$defs/digest" },
    "child_observation_envelope_sha256": { "$ref": "#/$defs/digest" },
    "launcher_pid": { "type": "integer", "minimum": 2 },
    "child_pid": { "type": "integer", "minimum": 2 },
    "peer_uid": { "type": "integer", "minimum": 1 },
    "peer_pid": { "type": "integer", "minimum": 2 },
    "challenge_nonce_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$", "description": "Canonical unpadded base64url of exactly 32 fresh random bytes; A checks decoding and non-reuse." },
    "after_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "prior_expires_at": { "type": "string", "format": "date-time" },
    "ready_envelope_sha256": { "$ref": "#/$defs/digest" },
    "hq_finalization_sha256": { "$ref": "#/$defs/digest" },
    "hq_finalization_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 10923 },
    "previous_lease_envelope_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
  },
  "allOf": [{ "if": { "properties": { "after_sequence": { "const": 0 } } }, "then": { "properties": { "previous_lease_envelope_sha256": { "type": "null" } } }, "else": { "properties": { "previous_lease_envelope_sha256": { "$ref": "#/$defs/digest" } } } }],
  "additionalProperties": false,
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}

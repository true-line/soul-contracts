{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/adapter/v4/qualification-attestation.schema.json",
  "title": "Stage 2a authenticated adapter qualification Statement",
  "description": "Decoded signed Statement payload. Shape alone proves neither signing-time trust nor physical results. Both report references require v4 host signatures and independently authenticated A pre-sign and post-sign records.",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "$ref": "https://true-line.ai/soul-contracts/adapter/v1/qualification-attestation.schema.json#/properties/subject"
    },
    "predicateType": {
      "const": "https://true-line.ai/soul-contracts/adapter/v4/macos-measured-qualification"
    },
    "predicate": {
      "type": "object",
      "required": [
        "host_reports",
        "expires_at",
        "release",
        "souls_build",
        "soul_artifact_sha256"
      ],
      "properties": {
        "host_reports": {
          "type": "object",
          "required": [
            "protected_report",
            "cooperative_report"
          ],
          "properties": {
            "protected_report": {
              "$ref": "https://true-line.ai/soul-contracts/adapter/v4/qualification-evidence.schema.json#/$defs/protected_report"
            },
            "cooperative_report": {
              "$ref": "https://true-line.ai/soul-contracts/adapter/v4/qualification-evidence.schema.json#/$defs/cooperative_report"
            }
          },
          "additionalProperties": false
        },
        "expires_at": {
          "$ref": "https://true-line.ai/soul-contracts/adapter/v1/qualification-attestation.schema.json#/properties/predicate/properties/expires_at"
        },
        "release": {
          "$ref": "https://true-line.ai/soul-contracts/adapter/v1/qualification-attestation.schema.json#/properties/predicate/properties/release"
        },
        "souls_build": {
          "$ref": "https://true-line.ai/soul-contracts/adapter/v2/qualification-evidence.schema.json#/$defs/souls_build"
        },
        "soul_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

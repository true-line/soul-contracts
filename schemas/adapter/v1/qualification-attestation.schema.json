{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/adapter/v1/qualification-attestation.schema.json",
  "title": "Draft macOS protected adapter qualification statement",
  "description": "Decoded in-toto Statement v1 payload from the designated release attestation. Shape does not establish signature validity or trust.",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "const": "qualification.json"
          },
          "digest": {
            "type": "object",
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "predicateType": {
      "const": "https://true-line.ai/soul-contracts/adapter/v1/macos-protected-qualification"
    },
    "predicate": {
      "type": "object",
      "required": [
        "host_reports",
        "expires_at"
      ],
      "properties": {
        "host_reports": {
          "description": "Raw fixed conformance report payloads, each verified with its designated host signature before certification.",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "https://true-line.ai/soul-contracts/adapter/v1/qualification-evidence.schema.json#/$defs/evidence_ref"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

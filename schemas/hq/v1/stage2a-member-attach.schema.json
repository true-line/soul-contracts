{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/hq/v1/stage2a-member-attach.schema.json",
  "title": "Verified two-member H-to-R post-Hello launch result (draft)",
  "description": "Only verified two-member managed-protected or managed-cooperative Stage 2a paths return this additive versioned result from stage2a.member.attach.prepare({runtime_id}) on the original authenticated Hello session, after H verifies A-signed aggregate Ready and live B. R then calls stage2a.member.attach({launch_id,attach}) on a fresh connection for one-use takeover of the already prestarted child. H must bind the same live R kernel UID, PIDVersion/process start across prepare and attach and bind runtime/launch/member/installation/start to the A-signed child. R independently verifies the fixed installed A pin, exact JCS bytes, signatures, hashes and live joins before bridge_ready or ACP attach. For cooperative only, H forwards the exact A-signed B observation and two separately encoded JCS B arm rows. Each Ready b_arm_receipt_sha256 hashes one decoded bridge_arm object, not its enclosing request. H-minted tokens remain local transport capabilities. A changed or missing field refuses. The complete result must be at most 32,768 JCS UTF-8 bytes for managed-cooperative or 131,072 JCS UTF-8 bytes for managed-protected, enforced by H and R. The synthetic cooperative candidate measures 24,290 JCS bytes; it is not a physical result.",
  "type": "object",
  "required": ["version", "installation_id", "start_id", "member_id", "member_selector", "runtime_id", "launch_id", "attach", "expires_at", "cwd", "member_socket", "member_endpoint", "member_bridge_token", "bridge_ready_nonce", "runner_endpoint", "child_observation_envelope_base64url", "child_observation_envelope_sha256", "member_b_authority_envelope_base64url", "member_b_authority_envelope_sha256", "ready_envelope_base64url", "ready_envelope_sha256"],
  "properties": {
    "version": { "const": "stage2a-member-attach/v1" },
    "installation_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/installation_id" },
    "start_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/properties/start_id" },
    "member_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_id" },
    "member_selector": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_selector" },
    "runtime_id": { "$ref": "https://true-line.ai/soul-contracts/hq/v1/admission-result.schema.json#/properties/admitted_runtimes/items/properties/runtime_id" },
    "launch_id": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/launch_id" },
    "attach": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expires_at": { "type": "string", "format": "date-time" },
    "cwd": { "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path" },
    "member_socket": { "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path" },
    "member_endpoint": {
      "description": "Profile-specific exact A-signed member endpoint. Protected projects out socket_path; cooperative includes the signed parent identity and expected B peer UID. R verifies equality to its signed assignment and live filesystem state.",
      "oneOf": [
        {
          "type": "object", "required": ["directory", "owner_uid", "group_gid", "dir_mode", "socket_mode", "peer_uids"],
          "properties": {
            "directory": { "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path" },
            "owner_uid": { "type": "integer", "minimum": 300, "maximum": 399 },
            "group_gid": { "type": "integer", "minimum": 300, "maximum": 399 },
            "dir_mode": { "const": 1512 },
            "socket_mode": { "const": 432 },
            "peer_uids": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "integer", "minimum": 300, "maximum": 399 } }
          }, "additionalProperties": false
        },
        { "$ref": "https://true-line.ai/soul-contracts/machine/v3/soul-cooperative-bridge-assignment-payload.schema.json#/$defs/endpoint" }
      ]
    },
    "member_bridge_token": { "type": "string", "pattern": "^[0-9a-f]{48}$" },
    "bridge_ready_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runner_endpoint": {
      "type": "object", "required": ["socketPath", "peerUid", "directory"],
      "properties": {
        "socketPath": { "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path" },
        "peerUid": { "description": "Expected connecting R client UID, equal to the A-signed member-set assignment runner_uid; this is not the H-owned admission socket's owner UID.", "type": "integer", "minimum": 300, "maximum": 399 },
        "directory": { "$ref": "https://true-line.ai/soul-contracts/machine/v2/snapshot-identity.schema.json#/properties/root_path" }
      }, "additionalProperties": false
    },
    "child_observation_envelope_base64url": { "$ref": "#/$defs/base64url" },
    "child_observation_envelope_sha256": { "$ref": "#/$defs/digest" },
    "member_b_authority_envelope_base64url": { "$ref": "#/$defs/base64url" },
    "member_b_authority_envelope_sha256": { "$ref": "#/$defs/digest" },
    "ready_envelope_base64url": { "$ref": "#/$defs/base64url" },
    "ready_envelope_sha256": { "$ref": "#/$defs/digest" },
    "bridge_observed_envelope_base64url": { "$ref": "#/$defs/base64url" },
    "bridge_arm_rows_base64url": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/base64url" }, "description": "Canonical unpadded base64url of exactly two distinct JCS B-to-H request.bridge_arm objects, ordered by A-signed member ID. R hashes each decoded object against its member Ready b_arm_receipt_sha256." }
  },
  "additionalProperties": false,
  "if": { "properties": { "member_endpoint": { "required": ["socket_path"] } }, "required": ["member_endpoint"] },
  "then": { "required": ["bridge_observed_envelope_base64url", "bridge_arm_rows_base64url"] },
  "else": { "not": { "anyOf": [ { "required": ["bridge_observed_envelope_base64url"] }, { "required": ["bridge_arm_rows_base64url"] } ] } },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/hq/v1/stage2a-b-member-arm-exchange.schema.json",
  "title": "Same-bound-broker two-member B observation and arm exchange (draft)",
  "description": "For the reviewed managed-protected B v3 producer only: B is the client on its already authenticated bridge.bind.v3 broker stream. It calls bridge.member.observe.v3 once per assigned member; H returns the full A-signed two-child observation before B arms that member. B independently verifies A's fixed installed pin, exact assignment and FD3 selectors, profile, plan, H map, live ACP process identity and expiry. B then calls bridge.member.arm.v3 on the same bound stream with its exact per-member bridge_arm receipt and JCS digest. H records it for paired A; the acknowledgment is pending only. A signs aggregate Ready only after both distinct receipts, and H delivers/verifies that Ready before ACP. No copied bind receipt, new endpoint, bearer or provider ingress is authorized. A refusal uses common/v1/error-response.schema.json on the same RPC and grants no state transition. Cooperative B requires its own reviewed source producer and endpoint identity rules.",
  "oneOf": [
    { "$ref": "#/$defs/observeRequest" },
    { "$ref": "#/$defs/observeResult" },
    { "$ref": "#/$defs/armRequest" },
    { "$ref": "#/$defs/armResult" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selectors": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-b-member-fd3.schema.json#/properties/selectors" },
    "memberId": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_id" },
    "memberSelector": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-assignment-payload.schema.json#/$defs/member/properties/member_selector" },
    "base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "observeRequest": {
      "type": "object", "required": ["kind", "selectors", "member_id", "member_selector", "observe_nonce"],
      "properties": {
        "kind": { "const": "bridge.member.observe.v3.request" },
        "selectors": { "$ref": "#/$defs/selectors" },
        "member_id": { "$ref": "#/$defs/memberId" },
        "member_selector": { "$ref": "#/$defs/memberSelector" },
        "observe_nonce": { "$ref": "#/$defs/nonce" }
      }, "additionalProperties": false
    },
    "observeResult": {
      "type": "object", "required": ["kind", "member_id", "member_selector", "observe_nonce", "child_observation_envelope_base64url", "child_observation_envelope_sha256", "expires_at"],
      "properties": {
        "kind": { "const": "bridge.member.observe.v3.result" },
        "member_id": { "$ref": "#/$defs/memberId" },
        "member_selector": { "$ref": "#/$defs/memberSelector" },
        "observe_nonce": { "$ref": "#/$defs/nonce" },
        "child_observation_envelope_base64url": { "$ref": "#/$defs/base64url", "description": "Full exact A-signed purpose agent-bot/stage2a-member-set-child-observation/v1 envelope, unpadded base64url; its payload contains both distinct children and the exact H provisional map." },
        "child_observation_envelope_sha256": { "$ref": "#/$defs/digest" },
        "expires_at": { "type": "string", "format": "date-time" }
      }, "additionalProperties": false
    },
    "armRequest": {
      "type": "object", "required": ["kind", "selectors", "member_id", "member_selector", "observe_nonce", "arm_nonce", "child_observation_envelope_sha256", "bridge_arm", "bridge_arm_receipt_sha256"],
      "properties": {
        "kind": { "const": "bridge.member.arm.v3.request" },
        "selectors": { "$ref": "#/$defs/selectors" },
        "member_id": { "$ref": "#/$defs/memberId" },
        "member_selector": { "$ref": "#/$defs/memberSelector" },
        "observe_nonce": { "$ref": "#/$defs/nonce" },
        "arm_nonce": { "$ref": "#/$defs/nonce" },
        "child_observation_envelope_sha256": { "$ref": "#/$defs/digest" },
        "bridge_arm": { "$ref": "https://true-line.ai/soul-contracts/machine/v3/stage2a-member-set-ready-payload.schema.json#/$defs/readyMember/properties/bridge_arm" },
        "bridge_arm_receipt_sha256": { "$ref": "#/$defs/digest", "description": "SHA-256 of exact RFC 8785 JCS bytes of bridge_arm; B spends this member's arm slot once on this bound stream." }
      }, "additionalProperties": false
    },
    "armResult": {
      "type": "object", "required": ["kind", "member_id", "member_selector", "arm_nonce", "bridge_arm_receipt_sha256", "state", "expires_at"],
      "properties": {
        "kind": { "const": "bridge.member.arm.v3.result" },
        "member_id": { "$ref": "#/$defs/memberId" },
        "member_selector": { "$ref": "#/$defs/memberSelector" },
        "arm_nonce": { "$ref": "#/$defs/nonce" },
        "bridge_arm_receipt_sha256": { "$ref": "#/$defs/digest" },
        "state": { "const": "recorded-pending-aggregate-ready" },
        "expires_at": { "type": "string", "format": "date-time" }
      }, "additionalProperties": false
    }
  }
}

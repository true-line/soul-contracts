{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/hq/v1/notice-query.schema.json",
  "title": "Notice Query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "request_id",
    "operation",
    "required_capabilities",
    "installation_epoch",
    "lease_generation"
  ],
  "properties": {
    "contract": {
      "const": "hq/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$(?![\\s\\S])"
    },
    "operation": {
      "enum": [
        "peek",
        "consume-one"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "const": [
        "notices-v1"
      ]
    },
    "installation_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 1
    },
    "expected_repository": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,100}$(?![\\s\\S])"
    }
  },
  "if": {
    "properties": {
      "operation": {
        "const": "consume-one"
      }
    },
    "required": [
      "operation"
    ]
  },
  "then": {
    "properties": {
      "count": {
        "const": 1
      }
    }
  }
}

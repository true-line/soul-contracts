{
  "$id": "https://true-line.ai/soul-contracts/hq/v1/stage2a-local-test-completion-ack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Source-enabling exact record shape; signed authority, cross-record joins, current lifetime and kernel observations require independent verification.",
  "properties": {
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "ok": {
      "const": true
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "const": true
        },
        "authorization_envelope_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "completed_run_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "completion_core_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "observed_body_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "selectors": {
          "additionalProperties": false,
          "properties": {
            "assignment_envelope_sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "authority_envelope_sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "installation_id": {
              "minLength": 1,
              "type": "string"
            },
            "launch_id": {
              "pattern": "^(st|ln)_[0-9a-f]{24}$",
              "type": "string"
            },
            "member_selectors_sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "plan_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "plan_id": {
              "minLength": 1,
              "type": "string"
            },
            "reservation_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "start_id": {
              "pattern": "^(st|ln)_[0-9a-f]{24}$",
              "type": "string"
            }
          },
          "required": [
            "assignment_envelope_sha256",
            "authority_envelope_sha256",
            "installation_id",
            "launch_id",
            "member_selectors_sha256",
            "plan_digest",
            "plan_id",
            "reservation_digest",
            "start_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "accepted",
        "authorization_envelope_sha256",
        "completed_run_sha256",
        "completion_core_sha256",
        "observed_body_sha256",
        "selectors"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "ok",
    "result"
  ],
  "title": "Stage 2a observed-body local-test stage2a local test completion ack",
  "type": "object"
}

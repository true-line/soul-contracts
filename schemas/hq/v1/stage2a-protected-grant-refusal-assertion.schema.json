{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/hq/v1/stage2a-protected-grant-refusal-assertion.schema.json",
  "title": "Draft T01 HQ pre-effect refusal assertion",
  "description": "HQ's own internal guard and durable sequence claim. This object is not signed by HQ and is not an OS no-effect observation. A accepts it only over an authenticated paired HQ channel and signs its exact bytes separately.",
  "type": "object",
  "required": ["contract", "kind", "schema_version", "host_id", "installation_id", "start_id", "launch_id", "hq_epoch", "runtime_id", "member_id", "installation_epoch", "lease_generation", "request_sha256", "grant_handle_sha256", "operation", "resource_selector", "prompt_sha256", "request_nonce_base64url", "code", "decision_stage", "effect_invoked", "seq", "recorded_at"],
  "properties": {
    "contract": {"const": "hq/v1"},
    "kind": {"const": "stage2a-protected-grant-refusal-assertion"},
    "schema_version": {"const": 1},
    "host_id": {"$ref": "stage2a-protected-grant-invoke.schema.json#/$defs/id"},
    "installation_id": {"$ref": "stage2a-protected-grant-invoke.schema.json#/properties/installation_id"},
    "start_id": {"$ref": "stage2a-protected-grant-invoke.schema.json#/properties/start_id"},
    "launch_id": {"$ref": "stage2a-protected-grant-invoke.schema.json#/properties/launch_id"},
    "hq_epoch": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_id": {"$ref": "stage2a-protected-grant-invoke.schema.json#/properties/runtime_id"},
    "member_id": {"$ref": "stage2a-protected-grant-invoke.schema.json#/$defs/id"},
    "installation_epoch": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1},
    "request_sha256": {"$ref": "stage2a-protected-grant-invoke.schema.json#/$defs/digest"},
    "grant_handle_sha256": {"$ref": "stage2a-protected-grant-invoke.schema.json#/$defs/digest"},
    "operation": {"$ref": "stage2a-protected-grant-invoke.schema.json#/properties/operation"},
    "resource_selector": {"$ref": "stage2a-protected-grant-invoke.schema.json#/properties/resource_selector"},
    "prompt_sha256": {"$ref": "stage2a-protected-grant-invoke.schema.json#/properties/prompt_sha256"},
    "request_nonce_base64url": {"$ref": "stage2a-protected-grant-invoke.schema.json#/properties/request_nonce_base64url"},
    "code": {"const": "caller_mismatch"},
    "decision_stage": {"const": "before_effect"},
    "effect_invoked": {"const": false},
    "seq": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/hq/v1/admission-result.schema.json",
  "title": "Admission result",
  "description": "Issued only by HQ in reply to Hello. Source: draft 0.3, Section 5 and Appendix A. Carries no secrets; channel bindings are opaque references to protected connections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "request_id",
    "decision_id",
    "installation_epoch",
    "profile",
    "negotiated_versions",
    "admitted_runtimes",
    "lease_generation",
    "lease_expires_at"
  ],
  "properties": {
    "contract": {
      "const": "hq/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "Echo of the Hello request_id."
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "installation_epoch": {
      "type": "integer",
      "minimum": 1,
      "description": "Authoritative current epoch; the commit fence (Section 5)."
    },
    "profile": {
      "type": "string",
      "enum": [
        "managed-protected",
        "managed-cooperative",
        "standalone-unenforced"
      ],
      "description": "Profile actually in force. Never silently weaker than requested without this field saying so."
    },
    "negotiated_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hq",
        "wire"
      ],
      "properties": {
        "hq": {
          "type": "integer",
          "minimum": 1
        },
        "wire": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "admitted_runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_id",
          "role",
          "runtime_id",
          "channel_binding"
        ],
        "properties": {
          "member_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "runtime_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "channel_binding": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "description": "Opaque reference to the protected channel HQ bound this runtime to; not a bearer token."
          }
        }
      }
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 1
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "E.g. a role whose adapter is unevaluated on this harness version (Section 10)."
    }
  }
}

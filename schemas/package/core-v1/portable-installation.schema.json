{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/package/core-v1/portable-installation.schema.json",
  "title": "Portable package installation record",
  "type": "object",
  "required": [
    "contract",
    "kind",
    "soul_id",
    "revision_profile",
    "definition_revision",
    "host_id",
    "installation_id",
    "selected_checkpoint_id"
  ],
  "properties": {
    "contract": {
      "const": "package/core-v1"
    },
    "kind": {
      "const": "installation"
    },
    "soul_id": {
      "$ref": "portable-definition.schema.json#/$defs/soulId"
    },
    "revision_profile": {
      "type": "string",
      "minLength": 1
    },
    "definition_revision": {
      "$ref": "portable-definition.schema.json#/$defs/digest"
    },
    "host_id": {
      "type": "string",
      "minLength": 1
    },
    "installation_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_checkpoint_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/package/core-v1/portable-checkpoint.schema.json",
  "title": "Portable package checkpoint record",
  "type": "object",
  "required": [
    "contract",
    "kind",
    "soul_id",
    "revision_profile",
    "definition_revision",
    "checkpoint_id",
    "definition_inventory",
    "selected_life",
    "source_installation_id",
    "source_restriction_epoch"
  ],
  "properties": {
    "contract": {
      "const": "package/core-v1"
    },
    "kind": {
      "const": "checkpoint"
    },
    "soul_id": {
      "$ref": "portable-definition.schema.json#/$defs/soulId"
    },
    "revision_profile": {
      "type": "string",
      "minLength": 1
    },
    "definition_revision": {
      "$ref": "portable-definition.schema.json#/$defs/digest"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "definition_inventory": {
      "type": "array",
      "items": {
        "$ref": "portable-definition.schema.json#/$defs/entry"
      },
      "uniqueItems": true
    },
    "selected_life": {
      "type": "array",
      "items": {
        "$ref": "portable-definition.schema.json#/$defs/entry"
      },
      "uniqueItems": true
    },
    "source_installation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_restriction_epoch": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}

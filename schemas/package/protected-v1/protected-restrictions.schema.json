{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/package/protected-v1/protected-restrictions.schema.json",
  "title": "Protected content restrictions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "kind",
    "statement",
    "signature_hex"
  ],
  "properties": {
    "contract": {
      "const": "package/protected-v1"
    },
    "kind": {
      "const": "restrictions"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soul_id",
        "checkpoint_sha256",
        "journal",
        "signer",
        "epoch",
        "held_versions",
        "selection_sha256"
      ],
      "properties": {
        "soul_id": {
          "$ref": "../core-v1/portable-definition.schema.json#/$defs/soulId"
        },
        "checkpoint_sha256": {
          "$ref": "../core-v1/portable-definition.schema.json#/$defs/digest"
        },
        "journal": {
          "type": "string",
          "minLength": 1
        },
        "signer": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "held_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "../core-v1/portable-definition.schema.json#/$defs/digest"
          }
        },
        "selection_sha256": {
          "$ref": "../core-v1/portable-definition.schema.json#/$defs/digest"
        }
      }
    },
    "signature_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}(?![\\s\\S])"
    }
  }
}

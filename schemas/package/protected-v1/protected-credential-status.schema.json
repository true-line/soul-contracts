{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/package/protected-v1/protected-credential-status.schema.json",
  "title": "Protected content credential-status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "kind",
    "capability",
    "status"
  ],
  "properties": {
    "contract": {
      "const": "package/protected-v1"
    },
    "kind": {
      "const": "credential-status"
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "status": {
      "enum": [
        "unknown",
        "unavailable",
        "locked",
        "available",
        "revoked",
        "missing",
        "unsupported"
      ]
    },
    "binding": {
      "$ref": "#/$defs/binding"
    }
  },
  "$defs": {
    "capability": {
      "enum": [
        "content-custody",
        "secret-retrieval",
        "scoped-token",
        "brokered-operation",
        "status-inspection",
        "write"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_ref",
        "principal",
        "scope",
        "purpose"
      ],
      "properties": {
        "binding_ref": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        }
      },
      "then": {
        "required": [
          "binding"
        ]
      }
    }
  ]
}

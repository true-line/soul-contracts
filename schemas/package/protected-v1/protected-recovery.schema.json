{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/package/protected-v1/protected-recovery.schema.json",
  "title": "Protected content recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "kind",
    "decision_id",
    "authority",
    "host",
    "soul_id",
    "checkpoint_sha256",
    "uncertainty",
    "operations",
    "versions",
    "expires"
  ],
  "properties": {
    "contract": {
      "const": "package/protected-v1"
    },
    "kind": {
      "const": "recovery"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "soul_id": {
      "$ref": "../core-v1/portable-definition.schema.json#/$defs/soulId"
    },
    "checkpoint_sha256": {
      "$ref": "../core-v1/portable-definition.schema.json#/$defs/digest"
    },
    "uncertainty": {
      "const": "freshness-unknown"
    },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "execute",
          "disclose"
        ]
      }
    },
    "versions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../core-v1/portable-definition.schema.json#/$defs/digest"
      }
    },
    "expires": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/control/v1/unlink-record.schema.json",
  "title": "Machine unlink record",
  "description": "Harbor cannot prevent owner-present local unlink; the machine returns to local-only.",
  "type": "object",
  "required": [
    "contract",
    "kind",
    "payload",
    "owner_presence"
  ],
  "properties": {
    "contract": {
      "const": "control/v1"
    },
    "kind": {
      "const": "unlink-record"
    },
    "payload": {
      "type": "object",
      "required": [
        "link_id",
        "machine_id",
        "owner_id",
        "revoked_control_key_id",
        "last_policy_sha256",
        "mode_after",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "link_id": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"
        },
        "machine_id": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"
        },
        "owner_id": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"
        },
        "revoked_control_key_id": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"
        },
        "last_policy_sha256": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/digest"
        },
        "mode_after": {
          "const": "local-only"
        },
        "issued_at": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/stamp"
        },
        "expires_at": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/stamp"
        }
      },
      "additionalProperties": false
    },
    "owner_presence": {
      "$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/owner_presence"
    }
  },
  "additionalProperties": false
}

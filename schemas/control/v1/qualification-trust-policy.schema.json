{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json",
  "title": "Draft decoded owner-signed qualification trust policy",
  "description": "Shape of a verified policy payload. Validation alone does not authenticate the owner, a release attestation or host evidence, and grants no protected launch authority.",
  "type": "object",
  "required": ["contract", "kind", "policy_revision", "owner_key_id", "issued_at", "expires_at", "release_workflow", "evidence_signers", "revocation_snapshot", "max_revocation_age_seconds"],
  "properties": {
    "contract": { "const": "control/v1" },
    "kind": { "const": "qualification-trust-policy" },
    "policy_revision": { "type": "integer", "minimum": 1 },
    "owner_key_id": { "$ref": "#/$defs/identifier" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "release_workflow": {
      "type": "object",
      "required": ["id", "repository", "workflow_path", "source_commit", "oidc_issuer", "certificate_identity", "trust_root_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "repository": { "const": "true-line/soul-adapters" },
        "workflow_path": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "oidc_issuer": { "type": "string", "format": "uri" },
        "certificate_identity": { "type": "string", "format": "uri" },
        "trust_root_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "evidence_signers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "host_id", "algorithm", "public_key_spki_der_base64"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "host_id": { "$ref": "#/$defs/identifier" },
          "algorithm": { "const": "ES256" },
          "public_key_spki_der_base64": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
        },
        "additionalProperties": false
      }
    },
    "revocation_snapshot": {
      "type": "object",
      "required": ["updated_at", "revoked_attestation_sha256", "revoked_evidence_signer_ids", "revoked_release_workflow_ids"],
      "properties": {
        "updated_at": { "type": "string", "format": "date-time" },
        "revoked_attestation_sha256": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "revoked_evidence_signer_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "revoked_release_workflow_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "additionalProperties": false
    },
    "max_revocation_age_seconds": { "const": 3600 }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/control/v1/qualification-policy-envelope.schema.json",
  "title": "Owner-signed qualification policy envelope",
  "description": "Offline signature envelope for the canonical control/v1 qualification trust policy payload. The pinned owner root is external to this envelope.",
  "type": "object",
  "required": ["schema_version", "purpose", "owner_key_id", "policy_sha256", "policy_base64url", "signature_base64url"],
  "properties": {
    "schema_version": { "const": 1 },
    "purpose": { "const": "agent-bot/qualification-policy/v1" },
    "owner_key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "policy_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policy_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "signature_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "additionalProperties": false
}

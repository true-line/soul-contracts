{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/control/v1/qualification-acceptance-witness.schema.json",
  "title": "Supplemental Machine/keyd qualification policy acceptance witness envelope",
  "description": "Shape only. The verifier obtains its distinct Secure Enclave witness public key from reviewed Machine pairing and release state, never this envelope.",
  "type": "object",
  "required": ["schema_version", "purpose", "witness_key_id", "payload_sha256", "payload_base64url", "signature_base64url"],
  "properties": {
    "schema_version": { "const": 1 },
    "purpose": { "const": "agent-bot/qualification-policy-acceptance-witness/v1" },
    "witness_key_id": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/identifier" },
    "payload_sha256": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256" },
    "payload_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 5462 },
    "signature_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/control/v3/qualification-trust-policy.schema.json",
  "title": "Draft owner-signed Stage 2a qualification trust policy with frozen Soul authority",
  "description": "Decoded owner-signed candidate. Adds a distinct frozen .soul receipt workflow/root, exact artifact and definition mapping, and revocations. Shape never authenticates owner approval or grants launch authority.",
  "type": "object",
  "required": [
    "contract",
    "kind",
    "policy_revision",
    "owner_key_id",
    "issued_at",
    "expires_at",
    "release_workflow",
    "souls_build_workflow",
    "evidence_signers",
    "revocation_snapshot",
    "max_revocation_age_seconds",
    "frozen_soul_build_workflow",
    "frozen_soul_mapping"
  ],
  "properties": {
    "contract": {
      "const": "control/v3"
    },
    "kind": {
      "const": "qualification-trust-policy"
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner_key_id": {
      "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/identifier"
    },
    "issued_at": {
      "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/properties/issued_at"
    },
    "expires_at": {
      "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/properties/expires_at"
    },
    "release_workflow": {
      "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/properties/release_workflow"
    },
    "souls_build_workflow": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "workflow_path",
        "source_commit",
        "source_tree",
        "oidc_issuer",
        "certificate_identity",
        "trust_root_sha256",
        "builder_sha256",
        "toolchain_sha256",
        "receipt_predicate_type",
        "bundle_media_type",
        "dsse_payload_type"
      ],
      "properties": {
        "id": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/identifier"
        },
        "repository": {
          "const": "true-line/agent-bot-souls"
        },
        "workflow_path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "oidc_issuer": {
          "type": "string",
          "format": "uri"
        },
        "certificate_identity": {
          "type": "string",
          "format": "uri"
        },
        "trust_root_sha256": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
        },
        "builder_sha256": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
        },
        "toolchain_sha256": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
        },
        "receipt_predicate_type": {
          "const": "https://true-line.ai/soul-contracts/adapter/v2/souls-build"
        },
        "bundle_media_type": {
          "const": "application/vnd.dev.sigstore.bundle.v0.3+json"
        },
        "dsse_payload_type": {
          "const": "application/vnd.in-toto+json"
        }
      },
      "additionalProperties": false
    },
    "evidence_signers": {
      "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/properties/evidence_signers"
    },
    "revocation_snapshot": {
      "type": "object",
      "required": [
        "updated_at",
        "revoked_attestation_sha256",
        "revoked_evidence_signer_ids",
        "revoked_release_workflow_ids",
        "revoked_souls_build_workflow_ids",
        "revoked_souls_build_receipt_sha256",
        "revoked_frozen_soul_build_workflow_ids",
        "revoked_frozen_soul_receipt_sha256",
        "revoked_frozen_soul_artifact_sha256"
      ],
      "properties": {
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_attestation_sha256": {
          "$ref": "#/$defs/sha256_set"
        },
        "revoked_evidence_signer_ids": {
          "$ref": "#/$defs/identifier_set"
        },
        "revoked_release_workflow_ids": {
          "$ref": "#/$defs/identifier_set"
        },
        "revoked_souls_build_workflow_ids": {
          "$ref": "#/$defs/identifier_set"
        },
        "revoked_souls_build_receipt_sha256": {
          "$ref": "#/$defs/sha256_set"
        },
        "revoked_frozen_soul_build_workflow_ids": {
          "$ref": "#/$defs/identifier_set"
        },
        "revoked_frozen_soul_receipt_sha256": {
          "$ref": "#/$defs/sha256_set"
        },
        "revoked_frozen_soul_artifact_sha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "max_revocation_age_seconds": {
      "const": 3600
    },
    "frozen_soul_build_workflow": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "workflow_path",
        "source_commit",
        "source_tree",
        "oidc_issuer",
        "certificate_identity",
        "trust_root_sha256",
        "builder_sha256",
        "toolchain_sha256",
        "receipt_predicate_type",
        "bundle_media_type",
        "dsse_payload_type",
        "artifact_format",
        "subject_name_template",
        "rekor_entry_kind",
        "rekor_entry_version",
        "transparency_log_id",
        "template"
      ],
      "properties": {
        "id": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/identifier"
        },
        "repository": {
          "const": "true-line/soul-package"
        },
        "workflow_path": {
          "const": ".github/workflows/stage2a-frozen-soul-receipt.yml"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "oidc_issuer": {
          "type": "string",
          "format": "uri"
        },
        "certificate_identity": {
          "type": "string",
          "format": "uri"
        },
        "trust_root_sha256": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
        },
        "builder_sha256": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
        },
        "toolchain_sha256": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
        },
        "receipt_predicate_type": {
          "const": "https://true-line.ai/soul-contracts/package/v1/frozen-soul-build"
        },
        "bundle_media_type": {
          "const": "application/vnd.dev.sigstore.bundle.v0.3+json"
        },
        "dsse_payload_type": {
          "const": "application/vnd.in-toto+json"
        },
        "artifact_format": {
          "const": "stage2a-frozen-hello-ustar/v1"
        },
        "subject_name_template": {
          "const": "sha256-{artifact_sha256}.soul"
        },
        "rekor_entry_kind": {
          "enum": [
            "dsse",
            "hashedrekord"
          ]
        },
        "rekor_entry_version": {
          "enum": [
            "0.0.1",
            "0.0.2"
          ]
        },
        "transparency_log_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "template": {
          "type": "object",
          "required": [
            "repository",
            "source_commit",
            "source_tree",
            "path",
            "template_tree"
          ],
          "properties": {
            "repository": {
              "const": "true-line/soul-conformance"
            },
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "const": "templates/hello.soul"
            },
            "template_tree": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rekor_entry_kind": {
                "const": "dsse"
              }
            }
          },
          "then": {
            "properties": {
              "rekor_entry_version": {
                "const": "0.0.1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rekor_entry_kind": {
                "const": "hashedrekord"
              }
            }
          },
          "then": {
            "properties": {
              "rekor_entry_version": {
                "const": "0.0.2"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "frozen_soul_mapping": {
      "type": "object",
      "description": "Owner-approved exact frozen artifact, Soul ID, claimed SoulLock definition digest and independently measured definition digest.",
      "required": [
        "soul_id",
        "artifact_sha256",
        "claimed_definition_digest",
        "definition_measurement"
      ],
      "properties": {
        "soul_id": {
          "type": "string",
          "pattern": "^agent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claimed_definition_digest": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
        },
        "definition_measurement": {
          "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256"
      }
    },
    "identifier_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/identifier"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/control/v2/qualification-trust-policy.schema.json",
  "title": "Draft owner-signed protected qualification trust policy with Souls build authority",
  "description": "Decoded owner-signed payload. Requires a separate Souls build workflow signer/root and exact reviewed source commit/tree. Shape cannot authenticate owner approval or grant launch authority.",
  "type": "object",
  "required": ["contract", "kind", "policy_revision", "owner_key_id", "issued_at", "expires_at", "release_workflow", "souls_build_workflow", "evidence_signers", "revocation_snapshot", "max_revocation_age_seconds"],
  "properties": {
    "contract": { "const": "control/v2" },
    "kind": { "const": "qualification-trust-policy" },
    "policy_revision": { "type": "integer", "minimum": 1 },
    "owner_key_id": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/identifier" },
    "issued_at": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/properties/issued_at" },
    "expires_at": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/properties/expires_at" },
    "release_workflow": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/properties/release_workflow" },
    "souls_build_workflow": {
      "type": "object",
      "required": ["id", "repository", "workflow_path", "source_commit", "source_tree", "oidc_issuer", "certificate_identity", "trust_root_sha256", "builder_sha256", "toolchain_sha256", "receipt_predicate_type", "bundle_media_type", "dsse_payload_type"],
      "properties": {
        "id": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/identifier" },
        "repository": { "const": "true-line/agent-bot-souls" },
        "workflow_path": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "oidc_issuer": { "type": "string", "format": "uri" },
        "certificate_identity": { "type": "string", "format": "uri" },
        "trust_root_sha256": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256" },
        "builder_sha256": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256" },
        "toolchain_sha256": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256" },
        "receipt_predicate_type": { "const": "https://true-line.ai/soul-contracts/adapter/v2/souls-build" },
        "bundle_media_type": { "const": "application/vnd.dev.sigstore.bundle.v0.3+json" },
        "dsse_payload_type": { "const": "application/vnd.in-toto+json" }
      },
      "additionalProperties": false
    },
    "evidence_signers": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/properties/evidence_signers" },
    "revocation_snapshot": {
      "type": "object",
      "required": ["updated_at", "revoked_attestation_sha256", "revoked_evidence_signer_ids", "revoked_release_workflow_ids", "revoked_souls_build_workflow_ids", "revoked_souls_build_receipt_sha256"],
      "properties": {
        "updated_at": { "type": "string", "format": "date-time" },
        "revoked_attestation_sha256": { "$ref": "#/$defs/sha256_set" },
        "revoked_evidence_signer_ids": { "$ref": "#/$defs/identifier_set" },
        "revoked_release_workflow_ids": { "$ref": "#/$defs/identifier_set" },
        "revoked_souls_build_workflow_ids": { "$ref": "#/$defs/identifier_set" },
        "revoked_souls_build_receipt_sha256": { "$ref": "#/$defs/sha256_set" }
      },
      "additionalProperties": false
    },
    "max_revocation_age_seconds": { "const": 3600 }
  },
  "$defs": {
    "sha256_set": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/sha256" }
    },
    "identifier_set": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "https://true-line.ai/soul-contracts/control/v1/qualification-trust-policy.schema.json#/$defs/identifier" }
    }
  },
  "additionalProperties": false
}

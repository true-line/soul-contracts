{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/records/v1/transfer-record.schema.json",
  "title": "Transfer record",
  "description": "0.4 §11 and Appendix A: Soul ID, source and destination installations, definition digest, life selection, manifest digest, settled-operation watermark, unresolved operations, epoch handoff evidence. No secrets or reusable grants: authority does not travel as bearer material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "soul_id",
    "source_installation_id",
    "destination_installation_id",
    "definition_digest",
    "manifest_digest",
    "settled_operation_watermark",
    "epoch_handoff_evidence"
  ],
  "properties": {
    "soul_id": {
      "type": "string",
      "pattern": "^agent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "destination_installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "definition_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "life_selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "knowledge",
              "dream_inputs",
              "comms_mirror",
              "member_homes",
              "workspaces"
            ]
          }
        }
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "settled_operation_watermark": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "epoch_handoff_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}

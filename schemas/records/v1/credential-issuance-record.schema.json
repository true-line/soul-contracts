{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/records/v1/credential-issuance-record.schema.json",
  "title": "Credential issuance record",
  "description": "0.4 Appendix A and §4: issuance ID, owner, device or installation, Soul, member, grant reference, scope, audience, expiry, DPoP key thumbprint, identity-service signature. Issued only by the identity service; never contains the credential itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issuance_id",
    "owner",
    "device_id",
    "soul_id",
    "grant_reference",
    "scope",
    "audience",
    "expiry",
    "dpop_thumbprint",
    "identity_service_signature"
  ],
  "properties": {
    "issuance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "member_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "soul_id": {
      "type": "string",
      "pattern": "^agent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "grant_reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expiry": {
      "type": "string",
      "format": "date-time"
    },
    "dpop_thumbprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "identity_service_signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,512}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/records/v1/eval-plan-record.schema.json",
  "title": "Eval plan record",
  "description": "0.4 §10 and Appendix A: run ID, candidate digest, baseline digest, cells (role, adapter at version, provider, model version), train and held-out task-set digests, tolerance, seed and temperature where fixed, cost cap. The baseline is the current accepted revision replayed in the same run; results carry absolute counts. Vendor names are permitted here and in evaluation records only (R10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "candidate_digest",
    "baseline_digest",
    "cells",
    "train_task_set_digest",
    "held_out_task_set_digest",
    "tolerance",
    "cost_cap"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseline_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "adapter",
          "adapter_version",
          "provider",
          "model_version"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "adapter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "adapter_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "model_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "train_task_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "held_out_task_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tolerance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "cost_cap": {
      "type": "number",
      "minimum": 0
    }
  }
}

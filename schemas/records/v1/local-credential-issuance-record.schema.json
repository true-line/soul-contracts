{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/records/v1/local-credential-issuance-record.schema.json",
  "title": "Local-only credential issuance record",
  "description": "A local-only issuer variant. It cannot claim identity-service issuance or introduce a Harbor dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "kind", "payload", "local_issuer_signature"],
  "properties": {
    "contract": {"const": "records/v1"},
    "kind": {"const": "local-credential-issuance-record"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuance_id", "owner", "machine_id", "device_id", "soul_id", "grant_reference", "scope", "audience", "expiry", "dpop_thumbprint", "issuer_kind", "issuer_key_id"],
      "properties": {
        "issuance_id": {"$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"},
        "owner": {"$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"},
        "machine_id": {"$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"},
        "device_id": {"$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"},
        "soul_id": {"type": "string", "pattern": "^agent_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "grant_reference": {"$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "audience": {"type": "string", "minLength": 1, "maxLength": 128},
        "expiry": {"$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/stamp"},
        "dpop_thumbprint": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
        "issuer_kind": {"const": "local-machine"},
        "issuer_key_id": {"$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/id"}
      }
    },
    "local_issuer_signature": {"$ref": "https://true-line.ai/soul-contracts/control/v1/policy-bundle.schema.json#/$defs/issuer_signature"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://true-line.ai/soul-contracts/records/v1/typed-note.schema.json",
  "title": "Typed note",
  "description": "0.4 §10 and Appendix A: note ID, type, task, member, runtime, timestamp, sources, provenance set, disclosure restrictions, body, superseded note references. Notes are self-reported and must be distinguished from broker receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "note_id",
    "type",
    "member_id",
    "runtime_id",
    "timestamp",
    "provenance",
    "body"
  ],
  "properties": {
    "note_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "decision",
        "finding",
        "commitment",
        "open_question",
        "handoff"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "member_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "runtime_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "owner",
          "hq",
          "member",
          "peer",
          "external-untrusted"
        ]
      }
    },
    "disclosure_restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "superseded_note_references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    }
  }
}
